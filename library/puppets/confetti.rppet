{
 "linnea": "rppet/1",
 "version": 1,
 "label": "Confetti",
 "desc": "Paper confetti. burst: shoots up from the bottom and tumbles down; rain: falls from the top without end. Size it to the area it should cover (scale in KE.puppet, or the layer's box).",
 "tags": [
  "effect",
  "confetti",
  "party",
  "celebrate",
  "kutlama",
  "konfeti"
 ],
 "size": [
  600,
  600
 ],
 "params": {
  "palette": {
   "type": "select",
   "options": [
    "party",
    "gold",
    "pastel",
    "mono"
   ],
   "default": "party",
   "label": "Colours"
  },
  "count": {
   "type": "number",
   "default": 70,
   "min": 5,
   "max": 300,
   "step": 5,
   "label": "Pieces"
  },
  "size": {
   "type": "number",
   "default": 1,
   "min": 0.3,
   "max": 3,
   "step": 0.1,
   "label": "Piece size"
  }
 },
 "states": {
  "burst": {
   "dur": 2.6,
   "loop": false,
   "label": "Burst"
  },
  "rain": {
   "dur": 4,
   "loop": true,
   "label": "Rain"
  }
 },
 "initial": "burst",
 "example": "KE.puppet(g, 'yay', t, { use: 'confetti', x: W / 2, y: H / 2, scale: Math.max(W, H) / 600, t0: 3, t1: 6 })",
 "draw": "function (g, p, t, s, u) {\n  const W = u.W, H = u.H, PI = Math.PI, r = u.rand, cl = u.clamp;\n  const pal = { party: ['#ff4d6d', '#ffd23f', '#3ccf6e', '#4d9bff', '#b388ff'], gold: ['#ffd700', '#ffb800', '#fff1a8', '#e6a817'], pastel: ['#ffc8dd', '#bde0fe', '#caffbf', '#fdffb6', '#cdb4db'], mono: ['#ffffff', '#c9c9c9', '#8a8a8a'] }[p.palette] || ['#ffffff'];\n  const n = Math.round(cl(p.count, 1, 400)), T = s.t, sz = p.size || 1;\n  for (let i = 0; i < n; i++) {\n    const a = r(i * 3.1 + 1), b = r(i * 7.7 + 2), c = r(i * 1.3 + 3), d = r(i * 5.9 + 4);\n    let x, y, rot, al = 1;\n    if (s.name === 'rain') {\n      const sp = (90 + c * 120) / 600 * H;\n      y = ((b * (H + 60) + T * sp) % (H + 60)) - 30; x = a * W + Math.sin(T * 1.8 + d * 6) * W * 0.03; rot = d * 6 + T * (c - 0.5) * 8;\n    } else {\n      // a quick throw that air slows down, then a slow flutter down\n      const vx = (a - 0.5) * W * 2.2, vy = -(1.4 + b * 1.2) * H, tt = Math.max(0, T - c * 0.15);\n      const drag = (1 - Math.exp(-tt * 2.6)) / 2.6;\n      x = W / 2 + vx * drag + Math.sin(tt * 5 + d * 6) * W * 0.02 * tt; y = H * 0.98 + vy * drag + (0.16 + c * 0.1) * H * tt;\n      rot = d * 6 + tt * (c - 0.5) * 16; al = cl((s.dur - T) / 0.5, 0, 1);\n      if (tt <= 0) continue;\n    }\n    g.save(); g.globalAlpha = al; g.translate(x, y); g.rotate(rot); g.scale(Math.cos(T * 7 + d * 9), 1);\n    g.fillStyle = pal[i % pal.length];\n    const w = (10 + a * 8) * sz * W / 600, h = (5 + b * 6) * sz * W / 600;\n    if (i % 5 === 0) { g.beginPath(); g.arc(0, 0, w * 0.45, 0, PI * 2); g.fill(); } else g.fillRect(-w / 2, -h / 2, w, h);\n    g.restore();\n  }\n}"
}