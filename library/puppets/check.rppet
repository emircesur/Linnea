{
 "linnea": "rppet/1",
 "version": 1,
 "label": "Check / cross",
 "desc": "A tick or a cross in a ring. draw: the ring sweeps round and the mark is drawn on; pop: it pulses; idle: it stays.",
 "tags": [
  "icon",
  "check",
  "tick",
  "cross",
  "yes",
  "no",
  "onay",
  "doğru",
  "yanlış"
 ],
 "size": [
  400,
  400
 ],
 "params": {
  "mark": {
   "type": "select",
   "options": [
    "check",
    "cross"
   ],
   "default": "check",
   "label": "Mark"
  },
  "color": {
   "type": "color",
   "default": "#3ccf6e",
   "label": "Colour"
  },
  "ring": {
   "type": "bool",
   "default": true,
   "label": "Ring"
  },
  "width": {
   "type": "number",
   "default": 26,
   "min": 6,
   "max": 60,
   "step": 1,
   "label": "Line width"
  }
 },
 "states": {
  "draw": {
   "dur": 0.9,
   "loop": false,
   "label": "Draw on"
  },
  "pop": {
   "dur": 1.1,
   "loop": true,
   "label": "Pulse"
  },
  "idle": {
   "dur": 1,
   "loop": true,
   "label": "Still"
  }
 },
 "initial": "draw",
 "example": "KE.puppet(g, 'ok', t, { use: 'check', x: W / 2, y: H / 2, t0: 1, t1: 4, params: { mark: 'check' } })",
 "draw": "function (g, p, t, s, u) {\n  const W = u.W, R = W * 0.4, PI = Math.PI, cl = u.clamp, e = u.ease;\n  const k = s.name === 'draw' ? s.k : 1;\n  const ring = p.ring ? e.out(cl(k / 0.55, 0, 1)) : 1, mark = e.inOut(cl((k - (p.ring ? 0.4 : 0)) / (p.ring ? 0.6 : 1), 0, 1));\n  g.save(); g.translate(W / 2, W / 2);\n  let z = 1;\n  if (s.name === 'pop') z = 1 + Math.sin(s.k * PI * 2) * 0.06;\n  if (s.name === 'draw') z = 0.8 + 0.2 * e.back(cl(k * 1.3, 0, 1));\n  g.scale(z, z);\n  g.lineCap = 'round'; g.lineJoin = 'round'; g.lineWidth = p.width; g.strokeStyle = p.color;\n  if (p.ring) {\n    g.globalAlpha = 0.16 * ring; g.fillStyle = p.color; g.beginPath(); g.arc(0, 0, R, 0, PI * 2); g.fill(); g.globalAlpha = 1;\n    g.beginPath(); g.arc(0, 0, R, -PI / 2, -PI / 2 + PI * 2 * ring); g.stroke();\n  }\n  const part = (pts, f) => {\n    let tot = 0; const L = []; for (let i = 1; i < pts.length; i++) { const d = Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]); L.push(d); tot += d; }\n    let left = tot * f; g.beginPath(); g.moveTo(pts[0][0], pts[0][1]);\n    for (let i = 1; i < pts.length && left > 0; i++) { const q = Math.min(1, left / L[i - 1]); g.lineTo(pts[i - 1][0] + (pts[i][0] - pts[i - 1][0]) * q, pts[i - 1][1] + (pts[i][1] - pts[i - 1][1]) * q); left -= L[i - 1]; }\n    g.stroke();\n  };\n  if (mark > 0) {\n    if (p.mark === 'cross') { part([[-0.36 * R, -0.36 * R], [0.36 * R, 0.36 * R]], cl(mark * 2, 0, 1)); if (mark > 0.5) part([[0.36 * R, -0.36 * R], [-0.36 * R, 0.36 * R]], cl(mark * 2 - 1, 0, 1)); }\n    else part([[-0.44 * R, 0.02 * R], [-0.13 * R, 0.32 * R], [0.46 * R, -0.3 * R]], mark);\n  }\n  g.restore();\n}"
}