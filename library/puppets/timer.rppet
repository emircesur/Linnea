{
 "linnea": "rppet/1",
 "version": 1,
 "label": "Countdown ring",
 "desc": "A ring that runs down with the seconds in the middle. run: counts down `seconds` from when the state starts; done: the empty ring flashes; idle: full and still.",
 "tags": [
  "ui",
  "timer",
  "countdown",
  "clock",
  "sayaç",
  "geri sayım"
 ],
 "size": [
  400,
  400
 ],
 "params": {
  "seconds": {
   "type": "number",
   "default": 5,
   "min": 1,
   "max": 600,
   "step": 1,
   "label": "Seconds"
  },
  "color": {
   "type": "color",
   "default": "#e9b84a",
   "label": "Ring"
  },
  "track": {
   "type": "color",
   "default": "#3a3a3f",
   "label": "Track"
  },
  "text": {
   "type": "color",
   "default": "#ffffff",
   "label": "Number"
  },
  "number": {
   "type": "bool",
   "default": true,
   "label": "Show the number"
  },
  "width": {
   "type": "number",
   "default": 28,
   "min": 4,
   "max": 80,
   "step": 1,
   "label": "Ring width"
  }
 },
 "states": {
  "run": {
   "dur": 5,
   "loop": false,
   "label": "Count down"
  },
  "done": {
   "dur": 0.8,
   "loop": true,
   "label": "Done (flash)"
  },
  "idle": {
   "dur": 1,
   "loop": true,
   "label": "Full"
  }
 },
 "initial": "run",
 "example": "KE.puppet(g, 'count', t, { use: 'timer', x: W / 2, y: H / 2, t0: 0, t1: 6, params: { seconds: 5 } })",
 "draw": "function (g, p, t, s, u) {\n  const W = u.W, c = W / 2, R = W * 0.38, PI = Math.PI, secs = Math.max(1, p.seconds || 5);\n  let left = s.name === 'run' ? Math.max(0, secs - s.t) : s.name === 'done' ? 0 : secs;\n  const f = left / secs;\n  g.save(); g.lineCap = 'round'; g.lineWidth = p.width;\n  g.strokeStyle = p.track; g.beginPath(); g.arc(c, c, R, 0, PI * 2); g.stroke();\n  if (s.name === 'done') { g.globalAlpha = 0.4 + 0.6 * Math.abs(Math.sin(s.k * PI)); g.strokeStyle = p.color; g.beginPath(); g.arc(c, c, R, 0, PI * 2); g.stroke(); g.globalAlpha = 1; }\n  else if (f > 0) { g.strokeStyle = p.color; g.beginPath(); g.arc(c, c, R, -PI / 2, -PI / 2 + PI * 2 * f); g.stroke(); }\n  if (p.number) {\n    const n = Math.ceil(left - 1e-6), frac = left - Math.floor(left), pop = s.name === 'run' && left > 0 ? 1 + 0.12 * Math.max(0, frac - 0.85) / 0.15 : 1;\n    g.translate(c, c); g.scale(pop, pop);\n    g.fillStyle = p.text; g.font = '800 ' + Math.round(W * 0.3) + 'px \"Segoe UI\", system-ui, sans-serif'; g.textAlign = 'center'; g.textBaseline = 'middle';\n    g.fillText(String(n), 0, W * 0.015);\n  }\n  g.restore();\n}"
}