{
 "linnea": "rppet/1",
 "version": 1,
 "label": "Mouse pointer",
 "desc": "An arrow pointer for screen demos. idle: rests with a small drift; click: presses once with a ripple from its tip; clicks: keeps clicking. Its tip is at about (110, 70) of its 300 × 300 box.",
 "tags": [
  "ui",
  "cursor",
  "mouse",
  "pointer",
  "click",
  "imleç",
  "fare",
  "tıkla"
 ],
 "size": [
  300,
  300
 ],
 "params": {
  "color": {
   "type": "color",
   "default": "#ffffff",
   "label": "Fill"
  },
  "outline": {
   "type": "color",
   "default": "#111111",
   "label": "Outline"
  },
  "ripple": {
   "type": "color",
   "default": "#e9b84a",
   "label": "Ripple"
  }
 },
 "states": {
  "idle": {
   "dur": 3,
   "loop": true,
   "label": "Rest"
  },
  "click": {
   "dur": 0.7,
   "loop": false,
   "label": "Click"
  },
  "clicks": {
   "dur": 0.9,
   "loop": true,
   "label": "Keep clicking"
  }
 },
 "initial": "idle",
 "example": "KE.puppet(g, 'mouse', t, { use: 'cursor', x: 640, y: 400, t0: 0, t1: 3, states: [{ state: 'click', t0: 1.2 }] })",
 "draw": "function (g, p, t, s, u) {\n  const PI = Math.PI, tipX = 110, tipY = 70;\n  let press = 0, rip = -1;\n  if (s.name === 'click' || s.name === 'clicks') { const k = s.k; press = k < 0.25 ? k / 0.25 : Math.max(0, 1 - (k - 0.25) / 0.35); rip = k; }\n  const dx = s.name === 'idle' ? Math.sin(t * 1.3) * 3 : 0, dy = s.name === 'idle' ? Math.cos(t * 1.7) * 2 : 0;\n  if (rip >= 0 && rip < 1) {\n    g.save(); g.strokeStyle = p.ripple; g.globalAlpha = 1 - rip; g.lineWidth = 8 * (1 - rip) + 2;\n    g.beginPath(); g.arc(tipX, tipY, 14 + rip * 80, 0, PI * 2); g.stroke();\n    g.globalAlpha = (1 - rip) * 0.35; g.fillStyle = p.ripple; g.beginPath(); g.arc(tipX, tipY, 10 + rip * 40, 0, PI * 2); g.fill(); g.restore();\n  }\n  g.save(); g.translate(tipX + dx, tipY + dy); const z = 1 - press * 0.12; g.scale(z, z);\n  g.beginPath(); g.moveTo(0, 0); g.lineTo(0, 150); g.lineTo(37, 116); g.lineTo(60, 170); g.lineTo(84, 160); g.lineTo(61, 107); g.lineTo(110, 105); g.closePath();\n  g.shadowColor = 'rgba(0,0,0,0.35)'; g.shadowBlur = 12; g.shadowOffsetY = 6;\n  g.fillStyle = p.color; g.fill(); g.shadowColor = 'transparent';\n  g.lineJoin = 'round'; g.lineWidth = 9; g.strokeStyle = p.outline; g.stroke();\n  g.restore();\n}"
}