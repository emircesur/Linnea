{
 "linnea": "rppet/1",
 "version": 1,
 "label": "Sparkles",
 "desc": "Four-point stars that twinkle. twinkle: each one grows, turns and fades in its own rhythm; pop: they all flash out at once.",
 "tags": [
  "effect",
  "sparkle",
  "star",
  "shine",
  "ışıltı",
  "yıldız"
 ],
 "size": [
  400,
  400
 ],
 "params": {
  "color": {
   "type": "color",
   "default": "#ffe58a",
   "label": "Colour"
  },
  "count": {
   "type": "number",
   "default": 6,
   "min": 1,
   "max": 30,
   "step": 1,
   "label": "Stars"
  }
 },
 "states": {
  "twinkle": {
   "dur": 1.6,
   "loop": true,
   "label": "Twinkle"
  },
  "pop": {
   "dur": 0.8,
   "loop": false,
   "label": "Flash out"
  }
 },
 "initial": "twinkle",
 "example": "KE.puppet(g, 'shine', t, { use: 'sparkle', x: 800, y: 300, t0: 1, t1: 4 })",
 "draw": "function (g, p, t, s, u) {\n  const W = u.W, H = u.H, PI = Math.PI, r = u.rand, cl = u.clamp, e = u.ease;\n  const star = (x, y, R, a) => { g.save(); g.translate(x, y); g.rotate(a); g.beginPath(); for (let i = 0; i < 8; i++) { const rr = i % 2 ? R * 0.22 : R, q = (i / 8) * PI * 2; g.lineTo(Math.cos(q) * rr, Math.sin(q) * rr); } g.closePath(); g.fill(); g.restore(); };\n  g.fillStyle = p.color; g.shadowColor = p.color; g.shadowBlur = W * 0.04;\n  const n = Math.round(cl(p.count, 1, 40));\n  for (let i = 0; i < n; i++) {\n    const x = (i === 0 ? 0.5 : 0.12 + r(i * 4.1) * 0.76) * W, y = (i === 0 ? 0.5 : 0.12 + r(i * 9.3) * 0.76) * H;\n    const R = (i === 0 ? 0.2 : 0.06 + r(i * 2.7) * 0.08) * W;\n    let z;\n    if (s.name === 'pop') z = Math.sin(cl(s.k * 1.2 - r(i) * 0.2, 0, 1) * PI) * 1.3;\n    else { const ph = (t / s.dur + r(i * 6.6)) % 1; z = Math.pow(Math.sin(ph * PI), 2); }\n    if (z <= 0.01) continue;\n    g.globalAlpha = cl(z, 0, 1); star(x, y, R * z, (s.name === 'pop' ? s.k : t * 0.5) + i);\n  }\n}"
}